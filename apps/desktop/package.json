{
  "name": "@osmium/desktop",
  "productName": "OsmiumIDE",
  "description": "OsmiumIDE — Desktop IDE and Multi-CLI Orchestrator",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "dev": "tsc -p tsconfig.main.json && vite build && electron dist/main/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@osmium/adapters": "workspace:*",
    "@osmium/core": "workspace:*",
    "@osmium/ide-core": "workspace:*",
    "@osmium/ui": "workspace:*",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  }
}
