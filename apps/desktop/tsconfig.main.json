{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/main/**/*", "src/preload/**/*"],
  "exclude": ["src/__tests__/**", "dist", "node_modules"]
}
