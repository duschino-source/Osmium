{
  "name": "@conductor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./dist/tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/tokens.css dist/tokens.css && mkdir -p dist/fonts && cp -r src/fonts/. dist/fonts/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@conductor/core": "workspace:*",
    "@conductor/adapters": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
