{
  "name": "osmiumide-monorepo",
  "description": "OsmiumIDE — Desktop IDE and Multi-CLI Orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm build:host && pnpm --filter @osmium/core build && pnpm --filter @osmium/ide-core build && pnpm --filter @osmium/adapters build && pnpm --filter @osmium/mock-cli build && pnpm --filter @osmium/ui build && pnpm --filter @osmium/desktop build",
    "build:host": "cargo build -p osmium-adapter-host -p osmium-mock-cli",
    "dev": "pnpm build:host && pnpm --filter @osmium/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx,css}\" \"e2e/*.ts\"", "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx,css}\" \"e2e/*.ts\"",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "ci": "bash scripts/ci.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
